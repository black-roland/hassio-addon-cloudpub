{
  "name": "CloudPub Client",
  "slug": "cloudpub",
  "version": "3.3.0-2",
  "description": "Внешний доступ к Home Assistant и другим локальным ресурсам без «белого» IP (за NAT)",
  "url": "https://github.com/black-roland/hassio-addon-cloudpub",
  "init": false,
  "startup": "application",
  "boot": "auto",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "image": "mansmarthome.cr.cloud.ru/black-roland/hassio-addon-cloudpub/{arch}",
  "stage": "stable",
  "map": [
    {
      "type": "addon_config",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": true
    }
  ],
  "options": {
    "token": "",
    "clo_log_level": "warn",
    "services": [
      {
        "name": "homeassistant",
        "type": "http",
        "local_addr": "homeassistant:80"
      }
    ]
  },
  "schema": {
    "token": "str",
    "services": [
      {
        "name": "str?",
        "type": "list(http|https|tcp|udp|rtsp|1c)",
        "local_addr": "str"
      }
    ],
    "clo_log_level": "list(debug|info|warn|error)",
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?"
  }
}
